# Askesis self-host config template. Copy to .env and fill in REAL values.
#   cp .env.example .env
# .env is gitignored — never put real secrets/hosts/emails in THIS file.
# Consumed by docker-compose.yml and passed into the app container.

# ── Tailscale (sidecar that publishes the app on the tailnet) ──────────────
# Auth key for the sidecar to join your tailnet (Admin console → Settings →
# Keys → Generate auth key; a reusable key survives redeploys). The app is then
# reachable at https://askesis.<your-tailnet>.ts.net (its own hostname → its own
# PWA). Change the "askesis" hostname in docker-compose.yml if you want another.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# ── Postgres (the bundled db service) ──────────────────────────────────────
# Pick a strong password. Used by the db service and the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# ── App secrets ────────────────────────────────────────────────────────────
# Session/JWT signing key.  Generate: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# ── Accounts ───────────────────────────────────────────────────────────────
# There is no OAuth. Accounts are username + password, created on the box:
#   docker compose exec app python backend/scripts/manage_users.py create \
#       --username you --email you@example.com --name "Your Name"
# (`set-password --username you` resets an existing account; `list` shows all.)

# ── Web / CORS ─────────────────────────────────────────────────────────────
# JSON array of allowed origins. The web app is served same-origin with the
# API, so this only matters if you add a cross-origin client.
CORS_ORIGINS=["https://askesis.<your-tailnet>.ts.net"]

# Production mode: true => HTTPS-only cookies (correct behind a TLS proxy).
DEV_MODE=false

# ── Optional ───────────────────────────────────────────────────────────────
TOKEN_EXPIRE_HOURS=720

# Food-database lookups: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Gemini meal-photo analysis. Without it the "analyze photo" feature returns
# 503 and everything else works: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DATABASE_URL is set by docker-compose to the bundled db service; only set it
# here if you remove that service to use an external Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/askesis
