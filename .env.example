# Askesis self-host config template. Copy to .env and fill in REAL values.
#   cp .env.example .env
# .env is gitignored — never put real secrets/hosts/emails in THIS file.
# Consumed by docker-compose.yml and passed into the app container.

# ── Tailscale (sidecar that publishes the app on the tailnet) ──────────────
# Auth key for the sidecar to join your tailnet (Admin console → Settings →
# Keys → Generate auth key; a reusable key survives redeploys). The app is then
# reachable at https://askesis.<your-tailnet>.ts.net (its own hostname → its own
# PWA). Change the "askesis" hostname in docker-compose.yml if you want another.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# ── Postgres (the bundled db service) ──────────────────────────────────────
# Pick a strong password. Used by the db service and the app's DATABASE_URL.
POSTGRES_PASSWORD=change-me

# ── App secrets ────────────────────────────────────────────────────────────
# Session/JWT signing key.  Generate: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# ── Accounts ───────────────────────────────────────────────────────────────
# There is no OAuth. Accounts are username + password, created on the box:
#   docker compose exec app python scripts/manage_users.py create \
#       --username you --email you@example.com --name "Your Name"
# (`set-password --username you` resets an existing account; `list` shows all.)

# ── Web / CORS ─────────────────────────────────────────────────────────────
# JSON array of allowed origins. The web app is served same-origin with the
# API, so this only matters if you add a cross-origin client.
CORS_ORIGINS=["https://askesis.<your-tailnet>.ts.net"]

# Your tailnet origin, same hostname as above. Read by deploy.sh ONLY, to smoke
# test that the app really is serving after a deploy — the app itself never
# reads it. Leave it unset and deploys still work, but that check is skipped
# and a broken deploy gets reported as a success.
PUBLIC_URL=https://askesis.<your-tailnet>.ts.net

# Production mode: true => HTTPS-only cookies (correct behind a TLS proxy).
DEV_MODE=false

# ── Optional ───────────────────────────────────────────────────────────────
TOKEN_EXPIRE_HOURS=720

# Food-database lookups: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Gemini meal-photo analysis. Without it the "analyze photo" feature returns
# 503 and everything else works: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DATABASE_URL is set by docker-compose to the bundled db service; only set it
# here if you remove that service to use an external Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/askesis

# ── MCP connector (Claude Cowork) ──────────────────────────────────────────
# All optional until you run the connector. The `mcp` service refuses to start
# without them, so leaving them unset simply means not bringing it up.
#
# This is the one internet-facing part of Askesis. Read SELF_HOSTING.md
# ("MCP connector") before enabling it — in particular the tailnet ACL, which
# is what stops the public node reaching anything else on your tailnet.

# A SEPARATE Tailscale auth key from TS_AUTHKEY above, created with the tag that
# carries `funnel` in your ACL. Separate so revoking one does not kill both
# sidecars, and so only this node can ever be publicly exposed.
TS_AUTHKEY_MCP=tskey-auth-xxxxxxxxxxxx

# The public HTTPS origin of the MCP node. Must match what you type into
# Claude's connector dialog character for character — a trailing slash breaks
# the RFC 8707 audience check and surfaces as a generic connection error.
MCP_PUBLIC_ORIGIN=https://askesis-mcp.<your-tailnet>.ts.net

# Signs MCP access tokens. MUST differ from SECRET_KEY: sharing them would make
# a leaked MCP token forgeable into an app session cookie. openssl rand -hex 32
MCP_TOKEN_SECRET=change-me-openssl-rand-hex-32

# A throwaway, NOT the app's SECRET_KEY. The MCP process imports app/database.py,
# which calls get_settings() at module scope and sys.exit(1)s *silently* on the
# placeholder — so it needs a value even though it signs nothing there. Giving it
# the app's key, or setting DEV_MODE=true to dodge this, are the two breaches the
# whole design exists to prevent. openssl rand -hex 32
MCP_APP_SECRET_KEY=change-me-openssl-rand-hex-32

# Password for the least-privilege `askesis_mcp` Postgres role. Create the role
# first — it is what stops a compromised MCP container rewriting password_hash:
#   docker compose exec -T db psql -U askesis -d askesis \
#     -v mcp_password="$(openssl rand -hex 24)" < backend/scripts/mcp_db_role.sql
MCP_DB_PASSWORD=change-me-openssl-rand-hex-24
