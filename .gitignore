# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Database
*.db
*.db-shm
*.db-wal
*.db-journal

# pg_dump output. Backups belong in ~/.askesis/backups/, but a stray dump in the
# checkout must never be committable: it holds every row plus bcrypt hashes.
*.sql
# ...but the operator scripts under backend/scripts/ are source, not dumps.
# Without this negation `mcp_db_role.sql` is silently absent from the commit and
# the deploy fails on a step SELF_HOSTING.md tells you to run.
!backend/scripts/*.sql

# Environment
.env
.env.local

# Server-side data bind-mounted into the app container (photos, inbox)
data/

# Node
node_modules/
dist/

# SvelteKit
.svelte-kit/
frontend/build/

# Backend static (built from frontend)
backend/static/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Claude Code local config
.claude/
