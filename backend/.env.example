# Development mode - auto-logs you in as a synthetic dev@askesis.local user,
# skipping the password form entirely. Never set this in production.
DEV_MODE=true

DATABASE_URL=sqlite:///./askesis.db
SECRET_KEY=your-secret-key-change-in-production

# CORS origins (JSON array format). The SPA is same-origin with the API, so
# this only matters if you point another origin at this server.
CORS_ORIGINS=["http://localhost:5173"]

# Token expiration in hours (default: 720 = 30 days)
TOKEN_EXPIRE_HOURS=2

# Where progress/meal photos are written (default: backend/uploads)
# UPLOADS_DIR=

# Self-signup, OFF unless this is set. With a value, the login screen offers
# "Create account" and requires this code. It is the only thing standing between
# anyone who can reach the login screen and a new account, so treat it as a
# password: openssl rand -hex 16
# REGISTRATION_CODE=

# Nightly Garmin pull. Off by default; needs a cached session (see --login).
# GARMIN_SYNC_ENABLED=false
# GARMIN_SYNC_TZ=UTC        # IANA zone. Sets BOTH the cron hour and the day
#                           # boundary. Leave at UTC and the pull fires in the
#                           # evening local time for the Americas, closing a day
#                           # that has not ended. `timedatectl` prints yours.
# GARMIN_SYNC_HOUR=4        # hour in GARMIN_SYNC_TZ; 3 is a good local value
# GARMIN_SYNC_DAYS=3        # re-read window; overlapping is deliberate
# GARMIN_SYNC_USER=         # only needed when more than one account exists

# Unattended recovery ONLY. Normal syncs use the cached token, which refreshes
# itself and does not expire while the schedule runs. Set these two if you want
# a lost token volume to recover without a shell -- at the cost of a plaintext
# password visible to `docker inspect`. Useless if your Garmin account has 2FA.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# Garmin Connect session directory (default: backend/.garminconnect).
# Populate it once with: python scripts/garmin_sync.py --login
# There is deliberately no GARMIN_PASSWORD here — the cached token replaces it.
# GARMIN_TOKENSTORE=

# External food databases (optional - Open Food Facts works without a key)
# Get free USDA key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# AI meal-photo analysis (optional). Without it /api/nutrition/analyze-photo
# returns 503 and everything else works. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ===== PRODUCTION SETTINGS =====
# With DEV_MODE=false there is no auto-login: create an account with
#   python scripts/manage_users.py create --username u --email u@x --name "U"
# DEV_MODE=false
# SECRET_KEY=<generate with: openssl rand -hex 32>
# CORS_ORIGINS=["https://askesis.<your-tailnet>.ts.net"]
# TOKEN_EXPIRE_HOURS=720
